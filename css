/* General Body and Fonts */
body {
    font-family: 'Noto Sans Ethiopic', 'Arial', sans-serif;
    margin: 0;
    padding: 0;
    line-height: 1.6;
    background-color: #f4f4f4;
    color: #333;
}

/* Header & Footer */
.header, .footer {
    background-color: #004d40; /* Dark green color */
    color: white;
    padding: 20px;
    text-align: center;
}

.logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
}

.logo {
    border-radius: 50%; /* Makes the logo a circle */
    margin-right: 20px;
}

.header h1 {
    font-size: 2.5em; /* Large font size for the Amharic name */
    margin: 0;
    font-weight: bold;
}

.header-text p {
    font-size: 1.2em;
    margin: 5px 0;
}

/* Middle Section */
.middle-section {
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.image-gallery {
    margin-bottom: 20px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
}

.image-gallery img {
    border-radius: 10px;
    max-width: 100%;
    height: auto;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.main-image {
    max-width: 600px;
}

.small-image {
    max-width: 300px;
}

.services {
    text-align: left;
    max-width: 800px;
    margin: auto;
}

.services h2 {
    text-align: center;
    font-size: 2em;
    color: #004d40;
}

.services ul {
    list-style-type: none; /* Removes the dots from the list */
    padding: 0;
}

.services li {
    background-color: #e0f2f1; /* Light green for list items */
    margin: 10px 0;
    padding: 15px;
    border-radius: 5px;
    font-size: 1.1em;
}

/* Footer Section */
.footer p {
    margin: 0;
    font-size: 1.1em;
}

.call-to-action strong {
    font-size: 1.5em;
    display: block;
    margin-top: 10px;
}

/* Media Queries for small screens */
@media (max-width: 768px) {
    .logo-container {
        flex-direction: column;
    }
    .logo {
        margin-right: 0;
        margin-bottom: 15px;
    }
    .header h1 {
        font-size: 1.8em;
    }
}
